# Environment configuration for Halaa Guest Check-in (mini-app)
# Do not commit real secrets or credentials to source control.

NODE_ENV=development

# Service ports
PORT=8100
WEB_PORT=3100

# Browser origin & proxy configuration
APP_ORIGIN=http://localhost:3100
BACKEND_PROXY_URL=http://127.0.0.1:8100
TRUST_PROXY_HOPS=1

# MongoDB (Dedicated database required; must not use parent halaa database)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=halaa_checkin_dev
# MONGODB_TLS_CERT_PATH=

# Export storage (Private disk location for temporary generated PDFs)
EXPORT_DIR=./data/exports

# Security & Sessions
# SESSION_SECRET=min-32-chars-random-secret-for-signing-or-csrf

# Optional flags
DEMO_SEED_ENABLED=false
