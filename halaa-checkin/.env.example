# Environment configuration for Halaa Guest Check-in (mini-app)
# Do not commit real secrets or credentials to source control.

NODE_ENV=development

# Service ports
PORT=8100
WEB_PORT=3100

# Browser origin & proxy configuration
APP_ORIGIN=http://localhost:3100
BACKEND_PROXY_URL=http://127.0.0.1:8100
TRUST_PROXY_HOPS=1

# MongoDB (Dedicated database required; must not use parent halaa database)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=halaa_checkin_dev
# MONGODB_TLS_CERT_PATH=

# Export storage (Private disk location for temporary generated PDFs)
EXPORT_DIR=./data/exports

# Security & Sessions
# Required in production (>=32 chars). Generate with: openssl rand -base64 48
# Never commit a real secret. Dev fallback is built-in; production fails fast without this.
SESSION_SECRET=change-me-generate-at-least-32-random-chars-for-prod

# Container / deployment (see deploy/README.md)
# IMAGE_TAG is the immutable GHCR release SHA pinned in /opt/halaa-checkin/.env.
# Never deploy production on a floating `latest` alone.
IMAGE_TAG=dev
# CHECKIN_ENV_FILE=/opt/halaa-checkin/config.env
# CHECKIN_DATA_DIR=/opt/halaa-checkin/data
# Chromium executable inside the API image (set by api/Dockerfile).
# CHROMIUM_PATH=/usr/bin/chromium

# Optional flags
DEMO_SEED_ENABLED=false
# Demo seed password (never committed): required only when running seed:demo, min 12 chars.
# DEMO_SEED_PASSWORD=
# Bundled Chromium location inside the API image (set by api/Dockerfile).
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
