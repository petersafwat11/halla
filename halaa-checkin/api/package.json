{
  "name": "@halaa-checkin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "node --test ../tests/e2e/*.test.js",
    "user:provision": "node scripts/provision-user.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "db:indexes": "node scripts/ensure-indexes.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore-verify": "node scripts/restore-verify.mjs",
    "purge:event": "node scripts/purge-event.mjs"
  },
  "dependencies": {
    "@halaa-checkin/contracts": "*",
    "content-disposition": "0.5.4",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.0.0",
    "mongoose": "8.9.7",
    "playwright-core": "1.50.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "mongodb-memory-server": "11.2.0",
    "pngjs": "^7.0.0",
    "supertest": "7.0.0"
  }
}
