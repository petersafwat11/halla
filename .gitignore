# Local runtime & test artifacts
data/
qa-evidence/
halaa-checkin/ui-ux-audit-screenshots/
halaa-backend/public/uploads/temp/
halaa-backend/public/uploads/events/
halaa-backend/public/uploads/templates/*/

# Cache
**/.cache/
**/.turbo/
**/.parcel-cache/
**/coverage/
**/.nyc_output/

# OS
.DS_Store
Thumbs.db

# Playwright MCP session artifacts (snapshots, console logs)
.playwright-mcp/

# Local DB logical backups
**/_db-backup-*/

# Archive & test artifacts
.archive*/

# Secrets & credentials (NEVER commit real values — examples only)
# NOTE: existing tracked copies must be removed with `git rm --cached` and the
# history purged as part of the credential-rotation step (see
# docs/store-readiness-EXTERNAL-STEPS.md). These patterns stop NEW copies.
**/.env
**/.env.*
**/config.env
**/*.pem
**/*.cer
**/*.crt
**/play-service-account*.json
**/service-account*.json
**/*service-account*.json
**/google-services.json
**/GoogleService-Info.plist
# Keep committed examples
!**/.env.example
!**/.env.*.example
!**/config.env.example
