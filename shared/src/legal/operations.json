      "collection": "payments",
      "model": "Payment",
      "triggerField": "updatedAt",
      "deletionTriggerField": "privacySubjectDeletedAt",
      "durationYears": 6,
      "retentionAnchor": "end_of_calendar_year",
      "action": "delete",
      "legalBasis": "legal_obligation",
      "subjectField": "userId",
      "eligibleStatuses": ["failed", "refunded", "voided", "paid", "captured", "partially_refunded"]
    },
    {
      "id": "billing-subscriptions-6y",
      "collection": "subscriptions",
      "model": "Subscription",
      "triggerField": "updatedAt",
      "deletionTriggerField": "privacySubjectDeletedAt",
      "durationYears": 6,
      "retentionAnchor": "end_of_calendar_year",
      "action": "delete",
      "legalBasis": "legal_obligation",
      "subjectField": "userId",
      "eligibleStatuses": ["expired", "cancelled", "completed"]
    },
    {
      "id": "billing-provider-events-6y",
      "collection": "revenuecatevents",
      "model": "RevenueCatEvent",
      "triggerField": "updatedAt",
      "deletionTriggerField": "privacySubjectDeletedAt",
      "durationYears": 6,
      "retentionAnchor": "end_of_calendar_year",
      "action": "delete",
      "legalBasis": "legal_obligation",
      "subjectField": "userId",
      "eligibleStatuses": ["processed", "ignored", "resolved"]
    },
