      "eligibleStatuses": []
    },
    {
      "id": "business-contract-6y",
      "collection": "businessplanassignments",
      "model": "BusinessPlanAssignment",
      "triggerField": "updatedAt",
      "deletionTriggerField": "privacySubjectDeletedAt",
      "durationYears": 6,
      "retentionAnchor": "end_of_calendar_year",
      "action": "delete",
      "legalBasis": "legal_obligation",
      "subjectField": "businessUserId",
      "eligibleStatuses": ["refunded", "failed", "expired", "cancelled", "superseded"]
