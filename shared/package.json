{
  "name": "@halla/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "legal:verify": "node scripts/verify-legal.mjs",
    "aso:verify": "node scripts/validate-aso-metadata.mjs"
