# Halaa production reverse proxy — automatic HTTPS (Let's Encrypt).
#
# Cloudflare note: if the halaa.com.sa DNS record is PROXIED (orange cloud),
# Caddy's public ACME challenge can be intercepted. For the cutover either set
# the record to DNS-only (grey cloud) so Caddy can obtain a Let's Encrypt cert,
# or switch to the Cloudflare DNS-01 challenge / a Cloudflare Origin certificate.
{
	email admin@halaa.com.sa
}

halaa.com.sa {
	encode zstd gzip

	# Public Moyasar Apple Pay domain association (mirrors public/.well-known file).
	handle /.well-known/apple-developer-merchantid-domain-association {
		header Content-Type text/plain
		respond "7b2276657273696f6e223a312c227073704964223a2243423939394539333137363744463341383644424145363131413331323544303133353543373842303636343033393832323336324134413238303246334136222c22637265617465644f6e223a313738373134353634373931307d" 200
	}


	# API + health probes → Express backend container
	@api path /api/v2/* /api/* /health /health/* /uploads/*
	handle @api {
		reverse_proxy api:8000
	}

	# Private guest pages retain strict privacy headers through the proxy.
	@businessGuest path /ar/business-invitation/* /en/business-invitation/* /business-invitation/*
	handle @businessGuest {
		header Cache-Control "private, no-store"
		header Referrer-Policy "no-referrer"
		header X-Robots-Tag "noindex, nofollow, noarchive"
		reverse_proxy web:3000
	}

	# Everything else → Next.js web container
	handle {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options SAMEORIGIN
			# Leave camera, geolocation and payment available to existing features.
			Permissions-Policy "microphone=(), usb=()"
			# Canonical HTTPS verified; deliberately no preload/includeSubDomains.
			Strict-Transport-Security "max-age=86400"
			# Observe first. HTTPS covers variable payment/3DS and upload hosts;
			# narrow after reviewing real signup, map, upload and payment traffic.
			Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://maps.googleapis.com https://maps.gstatic.com https://unpkg.com/leaflet@1.9.4/dist/leaflet.js; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com/leaflet@1.9.4/dist/leaflet.css; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https:; frame-src 'self' https:; media-src 'self' https: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
		}
		reverse_proxy web:3000
	}
}

www.halaa.com.sa {
	redir https://halaa.com.sa{uri} permanent
}
