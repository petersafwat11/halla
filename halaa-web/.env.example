# Browser-only Google Maps JavaScript key. Restrict by HTTPS referrer and to
# Maps JavaScript API + Places API. Never use the backend web-service key here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Comma-separated S3/CDN hostnames allowed by the authenticated template baker.
TEMPLATE_IMAGE_ALLOWED_HOSTS=

# Existing deployment variables (values intentionally omitted).
BACKEND_PROXY_URL=
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=
NEXT_PUBLIC_HALLA_WHATSAPP_NUMBER=
# Public GA4 web-stream ID (G-...). Tracking loads in production after visitor consent.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
