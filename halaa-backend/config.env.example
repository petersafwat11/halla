# =============================================================================
# Halaa backend — environment template
# =============================================================================
# Copy to `config.env` and fill with REAL values supplied out-of-band (a secret
# manager / CI secret store), NEVER committed to git. See SECURITY_NOTES.md for
# the secret-rotation + git-history-purge steps required before launch.
#
# Production-critical settings are pre-filled with their correct production
# values below (NODE_ENV, RATE_LIMIT_ENABLED) — do not weaken them in prod.
# =============================================================================

# ---- Runtime --------------------------------------------------------------
# MUST be "production" in prod: dev mode leaks stack traces to clients, serves
# Swagger publicly, and disables the Secure cookie flag.
NODE_ENV=production
PORT=8000

# ---- Database (MongoDB Atlas / X.509) -------------------------------------
DATABASE=mongodb+srv://<host>/<db>?...
DATABASE_PASSWORD=<db-password-if-used>
DATABASE_CERT_PATH=./certs/mongodb-x509.pem

# ---- Auth -----------------------------------------------------------------
# Long random secret (e.g. `openssl rand -hex 64`).
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=15m

# ---- App-store reviewer login (§5.2 / D7) ---------------------------------
# Reviewers sign in with DEDICATED EMAIL/PASSWORD accounts (no OTP). Seed them:
#   REVIEWER_HOST_EMAIL=review.host@halaa.com.sa \
#   REVIEWER_HOST_PASSWORD='<strong>' \
#   REVIEWER_VENDOR_EMAIL=review.vendor@halaa.com.sa \
#   REVIEWER_VENDOR_PASSWORD='<strong>' \
#   node scripts/seedReviewerAccounts.js
REVIEWER_HOST_EMAIL=
REVIEWER_HOST_PASSWORD=
REVIEWER_VENDOR_EMAIL=
REVIEWER_VENDOR_PASSWORD=
# REVIEWER_HOST_PLAN=premium_monthly
#
# The fixed-OTP phone bypass below is DISABLED in production (hard-gated off when
# NODE_ENV=production) and exists only for NON-PRODUCTION local QA of the phone
# OTP flow. Do NOT rely on it for store review — use the email/password accounts.
REVIEWER_TEST_PHONE=
REVIEWER_TEST_OTP=

# ---- Hardening / moderation toggles (§3.2 / §6) ---------------------------
# Fail boot when required production secrets/origins are missing. Set true
# AFTER credential rotation + secret-store migration.
STRICT_CONFIG=false
# Hard-enforce UGC Terms/Community-Rules acceptance before posting. Keep false
# on first backend deploy; set true only AFTER the new web+mobile builds (which
# record acceptance) are the live minimum. See EXTERNAL-STEPS §2.
UGC_TERMS_ENFORCED=false
# Moderation SLA (hours) for new reports. Default 48.
MODERATION_SLA_HOURS=48

# ---- Email (SMTP) ---------------------------------------------------------
EMAIL_USERNAME=<smtp-user>
EMAIL_PASSWORD=<smtp-app-password>
EMAIL_HOST=<smtp-host>
EMAIL_PORT=587

# ---- Frontend -------------------------------------------------------------
FRONTEND_URL=https://halaa.com.sa

# ---- SMS / cost -----------------------------------------------------------
SMS_COST_SAR=0.05

# ---- Cache / Redis (optional) ---------------------------------------------
CACHE_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- Taqnyat (SMS / WhatsApp) ---------------------------------------------
TAQNYAT_API_KEY=<taqnyat-key>
TAQNYAT_BASE_URL=https://api.taqnyat.sa
TAQNYAT_SENDER_NAME=<sender-name>
TAQNYAT_WA_BASE_URL=<taqnyat-wa-base-url>

# ---- WhatsApp / Meta webhook ----------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<verify-token>
# Temporary rollout mode requested by the product owner. While true, every
# callback is accepted without HMAC verification. Change to false as soon as
# the Meta App Secret is configured.
WHATSAPP_WEBHOOK_ALLOW_UNSIGNED=true
WHATSAPP_APP_SECRET=

# ---- AWS S3 ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=me-central-1
AWS_S3_BUCKET=<bucket-name>
AWS_S3_BASE_URL=<bucket-base-url>

# ---- Moyasar (web payments only — mobile uses native IAP) -----------------
MOYASAR_API_KEY=<moyasar-secret-key>
MOYASAR_PUBLISHABLE_KEY=<moyasar-publishable-key>
MOYASAR_BASE_URL=https://api.moyasar.com/v1
MOYASAR_WEBHOOK_SECRET=<moyasar-webhook-secret>
# Comma-separated allowlist of Moyasar webhook source IPs (defense-in-depth).
MOYASAR_WEBHOOK_IP_WHITELIST=

# ---- Push notifications (Expo) --------------------------------------------
# Optional: raises Expo push rate limits + enables enhanced security. Push
# works without it.
EXPO_ACCESS_TOKEN=

# ---- RevenueCat (in-app purchases — mobile store builds) -------------------
# Master switch. When "true", /health/ready and the boot config gate FAIL CLOSED
# unless every value below is present, well-formed, non-placeholder, and
# consistent with the committed store-catalog manifest.
NATIVE_BILLING_ENABLED=false
# Authorization header value RevenueCat sends with each webhook (set the same
# value in the RevenueCat dashboard). REQUIRED to accept IAP grant webhooks.
REVENUECAT_WEBHOOK_AUTH=
# Backend-only RevenueCat v1 REST secret (server key — NEVER the public SDK key,
# NEVER shipped to mobile). Required for the canonical subscriber snapshot that
# gates destructive lifecycle changes (expiration/refund fail closed without it).
REVENUECAT_API_KEY=
# RevenueCat project app id + expected environment + allowed stores. The webhook
# ignores events for a different app/environment and unsupported stores.
REVENUECAT_APP_ID=
REVENUECAT_ENVIRONMENT=PRODUCTION
REVENUECAT_ALLOWED_STORES=APP_STORE,PLAY_STORE
# Accepted webhook api_version(s) (comma list).
REVENUECAT_API_VERSION_ALLOWLIST=1.0
# The ONE recurring-access entitlement id. MUST equal the catalog entitlement
# ("recurring_access"); a mismatch fails billing readiness. No consumable/add-on
# may ever carry this id.
REVENUECAT_RECURRING_ENTITLEMENT_ID=recurring_access
# Optional deploy-time PIN of the store-catalog manifest. If set, they MUST match
# the committed manifest (labbe-backend-/src/shared/commerce/storeCatalog.generated.json)
# or readiness fails. Leave blank to trust the committed manifest as-is.
CATALOG_MANIFEST_VERSION=
CATALOG_MANIFEST_HASH=
# Processing lease + retry tuning (webhook replay safety). Defaults shown.
REVENUECAT_LEASE_MS=120000
REVENUECAT_MAX_ATTEMPTS=8
# Operational alerting for dead letters / mapping misses / snapshot failures.
REVENUECAT_ALERT_ENABLED=false
# OPTIONAL strict overrides: point a REAL console product id at a catalog code.
# The generated manifest already maps every proposed com.halla.<code> id, so
# these are only needed if the live store ids differ. Invalid JSON, unknown
# codes, cross-type or conflicting mappings FAIL billing readiness (never
# silently ignored). Example: {"123456789":"premium_monthly_100"}
REVENUECAT_PRODUCT_PLAN_MAP={}
REVENUECAT_ADDON_PRODUCT_MAP={}

# ---- Rate limiting --------------------------------------------------------
# MUST be "true" in production. When "false" every limiter (login, OTP,
# password reset, refresh) becomes a no-op — i.e. no brute-force protection.
RATE_LIMIT_ENABLED=true
# Privacy retention worker. Keep execution confirmation false until a reviewed
# dry-run report is approved. Synthetic development data may be used for tests.
RETENTION_ENFORCEMENT_ENABLED=false
RETENTION_EXECUTION_CONFIRMED=false
RETENTION_BATCH_SIZE=250
